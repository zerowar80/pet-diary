# Claude (Anthropic) - 최소 하나의 AI 키는 필수
ANTHROPIC_API_KEY=sk-ant-여기에-발급받은-키를-입력하세요

# Google Gemini - 사용하지 않으면 비워둬도 됩니다
GOOGLE_API_KEY=

# OpenAI ChatGPT - 사용하지 않으면 비워둬도 됩니다
OPENAI_API_KEY=

# 각 AI의 모델을 바꾸고 싶으면 아래 값을 수정하세요 (비워두면 기본값 사용)
# gemini-flash-latest처럼 "-latest"가 붙은 이름은 구글이 알아서 최신 안정 버전으로 자동 연결해줘서,
# 특정 버전이 나중에 서비스 종료(deprecated)되어도 별도 수정 없이 계속 동작합니다.
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4o

# 로그인 세션 암호화에 사용되는 임의의 긴 문자열로 반드시 바꿔주세요
SESSION_SECRET=여기에-무작위로-긴-문자열을-입력하세요

# 웹 접속 포트 (비워두면 8000 사용. LXC 설치 스크립트가 실행 중 물어보고 자동으로 채워줍니다)
APP_PORT=
